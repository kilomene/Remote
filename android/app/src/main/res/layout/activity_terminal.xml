<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_elev"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btn_term_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_close"
            android:padding="11dp"
            android:contentDescription="@string/back" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/term_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btn_term_new"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_add"
            android:padding="11dp"
            android:contentDescription="@string/term_new" />

        <ImageButton
            android:id="@+id/btn_term_keyboard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_keyboard"
            android:padding="11dp"
            android:contentDescription="@string/term_keyboard" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/term_holder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/term_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_elev"
        android:padding="8dp"
        android:textColor="@color/text_faint"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_elev"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/term_keyrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp" />
    </HorizontalScrollView>

</LinearLayout>
