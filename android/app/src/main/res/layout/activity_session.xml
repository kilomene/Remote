<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.remote.viewer.StreamView
        android:id="@+id/stream_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_toolbar"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btn_disconnect"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_close"
            android:padding="11dp"
            android:contentDescription="@string/disconnected" />

        <ImageButton
            android:id="@+id/btn_keyboard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_keyboard"
            android:padding="11dp"
            android:contentDescription="keyboard" />

        <ImageButton
            android:id="@+id/btn_quality"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_sliders"
            android:padding="11dp"
            android:contentDescription="quality" />

        <ImageButton
            android:id="@+id/btn_files"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_folder"
            android:padding="11dp"
            android:contentDescription="@string/files" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:drawableStart="@drawable/ic_stats"
            android:drawablePadding="6dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/status_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_toolbar"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/btn_stop_reconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/stop"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
