<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_files_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_close"
            android:padding="12dp"
            android:contentDescription="@string/cancel" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/files"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/btn_files_up"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_chevron"
            android:rotation="270"
            android:padding="12dp"
            android:contentDescription="up" />

        <ImageButton
            android:id="@+id/btn_files_mkdir"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_add"
            android:padding="12dp"
            android:contentDescription="@string/new_folder" />

        <ImageButton
            android:id="@+id/btn_files_upload"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_download"
            android:rotation="180"
            android:padding="12dp"
            android:contentDescription="@string/upload" />
    </LinearLayout>

    <TextView
        android:id="@+id/files_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="start" />

    <ListView
        android:id="@+id/files_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/files_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_faint"
        android:textSize="13sp" />

</LinearLayout>
