#!/bin/sh
# postinst for the remote package. Creates the unprivileged service user
# and state directories; does NOT enable the service until the user has
# set a password (gate logic below is unchanged).
set -e

# service account (id check first: never fail if it already exists)
if ! id yourremote >/dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin \
        --comment "Remote host service account" yourremote
fi

mkdir -p /etc/remote /var/log/remote /var/lib/remote/files
chown yourremote:yourremote /etc/remote /var/log/remote /var/lib/remote /var/lib/remote/files
chmod 700 /etc/remote
chmod 750 /var/log/remote
chmod 750 /var/lib/remote /var/lib/remote/files

# video group so the service user can open the v4l2loopback virtual
# camera (/dev/video0) used by the Camera-for-Verification feature.
# Best-effort: never fails the install.
if id yourremote >/dev/null 2>&1; then
    adduser yourremote video >/dev/null 2>&1 || true
fi

if [ ! -f /etc/remote/host.conf ]; then
    echo "-----------------------------------------------------------------"
    echo "Remote installed. Finish setup with:"
    echo "  sudo yourremote-network-setup   # Tailscale first-run wizard"
    echo "  sudo remote-set-password"
    echo "  sudo systemctl enable --now remote-host"
    echo "Then connect from the Android viewer using this machine's"
    echo "Tailscale IP and the password you just set."
    echo "-----------------------------------------------------------------"
fi

#DEBHELPER#

exit 0
