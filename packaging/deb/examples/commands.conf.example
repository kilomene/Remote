# commands.conf.example -- extra allowlisted system actions.
# Install as /etc/remote/commands.conf (mode 0600, owned by yourremote).
#
# Format: INI, one section per extra action name. Each action maps to an
# EXACT argv list (parsed with shlex; argv[0] must be an absolute path).
# Launched with subprocess and an argv list -- NEVER through a shell, so
# there is no injection surface beyond the fixed arguments below.
#
# The built-in actions (lock, logout, reboot, shutdown, suspend,
# open-terminal, open-browser, open-app, blank-screen, switch-display,
# service) live in host/sys_cmd.py and do not need entries here.
# Anything not listed in either place is rejected with "not allowed".

[screenshot]
argv = /usr/bin/gnome-screenshot -f /tmp/remote-screenshot.png
