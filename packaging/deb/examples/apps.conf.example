# apps.conf.example -- allowlisted GUI apps for SYSTEM_CMD "open-app".
# Install as /etc/remote/apps.conf (mode 0600, owned by yourremote).
# Edit with: sudo yourremote-settings
#
# Format: INI, one section per app id (lowercase letters, digits, - _).
#   name = friendly display name
#   exec = absolute path (plus optional fixed arguments); launched with an
#          argv list -- NEVER through a shell.
#
# Only apps listed here can be launched remotely. The built-in desktop-file
# map in host/sys_cmd.py is used when this file has no entry.

[terminal]
name = Terminal
exec = /usr/bin/gnome-terminal

[files]
name = Files
exec = /usr/bin/nautilus

[browser]
name = Browser
exec = /usr/bin/firefox
