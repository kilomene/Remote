# policy.conf.example -- example Remote host policy file.
# Install as /etc/remote/policy.conf (mode 0600, owned by yourremote).
# Edit with: sudo yourremote-settings
#
# Format: INI. Keys, sections and value kinds are fixed (see
# host/yourremote_settings.py POLICY_SCHEMA); unknown keys are ignored.

[privacy]
# Sync the text clipboard both ways with viewers.
clipboard_sync = yes
# Sync clipboard *images* (v4 feature). Off by default.
clipboard_images = no
# Audio streaming (planned; host loopback capture not implemented yet).
audio_enabled = no

[pairing]
# Trust-on-first-use: a new device that passes the password challenge is
# recorded in /etc/remote/trusted_devices. Set to no to only allow
# devices paired explicitly via `yourremote-pair-code`.
allow_new_pairing = yes

[session]
# Disconnect idle viewers after this many minutes. 0 = never.
timeout_minutes = 30

[files]
# Jail root for all file-transfer paths. Empty = the service user's home.
file_root =
